NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nagar_seva
DB_USER=nagar_seva_app
DB_PASSWORD=change_me
CORS_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy (nginx, load balancer)
TRUST_PROXY=false
# ElevenLabs is called directly by this Node backend. Never expose this key to the frontend.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TIMEOUT_MS=30000
DEFAULT_LANGUAGE=as
# Transcriptions below this confidence are not used; the citizen is asked to repeat
STT_MIN_CONFIDENCE=0.4
# Lower threshold for free-text answers (problem, location, name), which are always read back
STT_MIN_CONFIDENCE_FREE_TEXT=0.25
# Complaint photos (stored outside the database; storage/ is gitignored)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
# Citizen upload links expire after this many hours and accept this many photos
UPLOAD_LINK_TTL_HOURS=48
UPLOAD_LINK_MAX_UPLOADS=5
# Reports group dates by this UTC offset (India Standard Time)
REPORT_UTC_OFFSET=+05:30
