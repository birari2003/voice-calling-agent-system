# Shared secret; must match AI_SERVICE_TOKEN in backend/.env
AI_SERVICE_TOKEN=change_me_to_a_long_random_value
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
TORCH_THREADS=4
# Load all models at startup instead of on first use (slower start, faster first reply)
PRELOAD_MODELS=false

# Speech-to-text: "whisper" (local, private, slower on CPU), "elevenlabs" or "sarvam" (cloud:
# fast and accurate for Hindi/Assamese; sends citizen audio to the provider, which needs
# municipal approval).
STT_PROVIDER=whisper
# Voice: "mms" (local; non-commercial licence) or "elevenlabs" (cloud)
TTS_PROVIDER=mms
TTS_FALLBACK_TO_LOCAL=true
# ElevenLabs key needs the "Speech to Text" and "Text to Speech" permissions
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
# Use the local engine automatically if the cloud provider fails
STT_FALLBACK_TO_LOCAL=true
