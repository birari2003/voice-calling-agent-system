# Copy to deploy/staging.env (gitignored) and replace every value.
# Public address of the site; must match how users open it (scheme, host and port).
PUBLIC_URL=https://localhost:8443
SITE_ADDRESS=localhost
HTTPS_PORT=8443
HTTP_PORT=8080

DB_NAME=nagar_seva
DB_USER=nagar_seva_app
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

# Shared secret between the API and the speech service: openssl rand -hex 24
AI_SERVICE_TOKEN=replace-with-48-hex-characters-from-openssl-rand
PRELOAD_MODELS=false
# Speech-to-text: whisper (local) or sarvam (cloud; needs approval to send citizen audio)
STT_PROVIDER=whisper
SARVAM_API_KEY=
# Voice: mms (local) or elevenlabs. ElevenLabs keys need Speech to Text + Text to Speech permissions.
TTS_PROVIDER=mms
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
STT_FALLBACK_TO_LOCAL=true

# First Super Admin, created by the migrate job if it does not exist yet (14+ characters).
ADMIN_EMAIL=admin@example.gov.in
ADMIN_PASSWORD=replace-with-a-strong-password

REPORT_UTC_OFFSET=+05:30
